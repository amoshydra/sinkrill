# Maintainer: Amos Hydra <https://github.com/amoshydra>
pkgname=sinkrill
pkgver=0.2.1
pkgrel=1
pkgdesc="Stream this computer's audio to Sonos speakers over the LAN"
arch=('x86_64' 'aarch64')
url="https://github.com/amoshydra/sinkrill"
license=('MIT')
depends=('libpulse')
optdepends=('ffmpeg: MP3 streaming mode')
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('98cc303afdee681a6213cd50dec6bad8ceb95113d665be2f33fe7ea8575e9846')

build() {
	cd "$pkgname-$pkgver"
	export CGO_ENABLED=0
	go build -trimpath -ldflags "-s -w -X main.version=$pkgver" -o sinkrill .
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 sinkrill "$pkgdir/usr/bin/sinkrill"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 contrib/systemd/sinkrill.service \
		"$pkgdir/usr/lib/systemd/user/$pkgname.service"
}
