[Unit]
Description=Stream PC audio to Sonos
Documentation=https://github.com/amoshydra/sonos-sink
After=pipewire-pulse.service
Wants=pipewire-pulse.service

[Service]
Type=simple
# Edit the room name (or use --device <ip>). Add --format mp3 on weak Wi-Fi.
ExecStart=%h/.local/bin/sonos-sink --device "Living Room" --virtual-sink
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
